# Copy this file to .env and fill in the values you need:  cp .env.example .env
# Lines starting with # are comments. Inline comments are NOT supported, so keep
# comments on their own line. Real environment variables override values in .env.
# Never commit your .env file (it is in .gitignore).

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
# 1 = verbose server logs (never includes API keys).
LARGEN_DEBUG=0
# Conversation storage directory (relative to the project root).
LARGEN_DATA_DIR=data
# 1 only when behind a trusted reverse proxy, so rate limiting uses X-Forwarded-For.
TRUST_PROXY=0

# ---------------------------------------------------------------------------
# AI provider: writes plans, search queries, and answers
# Values: openai-compatible | mock | none
# Empty: openai-compatible if AI_API_KEY is set, otherwise none.
# ---------------------------------------------------------------------------
AI_PROVIDER=openai-compatible
AI_API_KEY=
# Any OpenAI-compatible base URL, for example:
#   OpenAI:      https://api.openai.com/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Groq:        https://api.groq.com/openai/v1
#   Ollama:      http://localhost:11434/v1   (optional local model; set AI_JSON_MODE=0)
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Ask for JSON responses (response_format). Set to 0 if your provider rejects it.
AI_JSON_MODE=1
AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=1500

# ---------------------------------------------------------------------------
# Search provider: finds candidate web pages
# Values: brave | searxng | mock | none
# Empty: brave if SEARCH_API_KEY is set, otherwise none.
# ---------------------------------------------------------------------------
SEARCH_PROVIDER=brave
SEARCH_API_KEY=
# Used only by searxng. Point this at your own instance (JSON output must be enabled).
SEARXNG_URL=http://localhost:8080
SEARCH_RESULTS_PER_QUERY=6
SEARCH_TIMEOUT_MS=15000
SEARCH_CACHE_TTL_MS=3600000
SEARCH_CONCURRENCY=3

# ---------------------------------------------------------------------------
# Research limits: cost and time controls per depth mode (Quick | Research | Deep)
# The complexity of a question can lower these caps, never raise them.
# ---------------------------------------------------------------------------
QUICK_MAX_SEARCHES=2
RESEARCH_MAX_SEARCHES=6
DEEP_MAX_SEARCHES=10
QUICK_MAX_PAGES=3
RESEARCH_MAX_PAGES=6
DEEP_MAX_PAGES=10
MAX_RESEARCH_MS=120000
MAX_EVIDENCE_CHARS=12000
MAX_PASSAGE_CHARS=1200
MAX_CONCURRENT_RUNS=2

# ---------------------------------------------------------------------------
# Page fetching
# ---------------------------------------------------------------------------
PAGE_TIMEOUT_MS=12000
MAX_PAGE_BYTES=1500000
PAGE_CACHE_TTL_MS=21600000
FETCH_CONCURRENCY=4
# Keep 0 in production. 1 lets Largen read localhost and private-network addresses (SSRF risk).
ALLOW_PRIVATE_FETCH=0

# ---------------------------------------------------------------------------
# Abuse protection and chat history
# ---------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=20
MAX_QUESTION_CHARS=2000
MAX_HISTORY_TURNS=6
