{
  "name": "largen",
  "version": "0.1.0",
  "private": true,
  "description": "Largen: a research assistant that plans searches, reads sources, compares evidence, and answers with citations.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "check": "node --check src/server.js && node --check src/app.js"
  }
}
